// =============================================================================
// Érika Dias · Psicóloga — site e sistema de consultório
// Modelo de dados
//
// Princípios:
//  - Dados de saúde (LGPD, art. 11): textos clínicos/sensíveis são gravados
//    CRIPTOGRAFADOS (campos terminados em "Cripto"), com a chave
//    CHAVE_CRIPTOGRAFIA. Quem tiver só o banco não consegue lê-los.
//  - Nada de paciente é apagado: o registro documental de psicologia precisa
//    ser guardado por pelo menos 5 anos (Resolução CFP 001/2009). Paciente
//    que encerrou o acompanhamento vira "ALTA"/"INATIVO", não some.
//  - Valores em dinheiro são inteiros em CENTAVOS (sem erro de arredondamento).
//  - Datas "de calendário" (nascimento) ficam à meia-noite UTC.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ----------------------------------------------------------------------------
// ACESSO
// ----------------------------------------------------------------------------

/// ADMIN = a psicóloga (vê tudo). TOTAL = administrador do sistema (quem
/// mantém o app; vê tudo; só um ativo; a psicóloga vê e pode desativar).
/// ASSISTENTE = secretária(o): pedidos e cadastro, sem textos clínicos.
/// SUPORTE = apoio técnico: só usuários.
enum Papel {
  ADMIN
  ASSISTENTE
  SUPORTE
  TOTAL
}

model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String
  papel        Papel     @default(ASSISTENTE)
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  sessoes      Sessao[]
}

/// O id é uma "impressão digital" (HMAC com SESSION_SECRET) do código que fica
/// no cookie: quem ler esta tabela não consegue montar um cookie válido.
model Sessao {
  id        String   @id
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  ip        String?
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

/// Tentativas de login erradas (no banco: na Vercel cada acesso pode cair numa
/// cópia diferente do servidor, e um contador em memória recomeçaria do zero).
model TentativaLogin {
  // "endereco|email", "*|email" ou "pre-cadastro|endereco"
  chave      String   @id
  erros      Int
  primeiraEm DateTime

  @@index([primeiraEm])
}

/// Quem fez o quê e quando (inclusive quem abriu a ficha de um paciente).
model Auditoria {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuarioNome String
  acao        String // CRIAR, ALTERAR, VISUALIZAR, LOGIN, ...
  entidade    String
  entidadeId  String?
  resumo      String
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade, entidadeId])
}

// ----------------------------------------------------------------------------
// PACIENTES
// ----------------------------------------------------------------------------

enum Modalidade {
  PRESENCIAL
  ONLINE
  DOMICILIO
}

enum AreaAtendimento {
  GESTACAO
  PUERPERIO
  PARENTALIDADE
  SAUDE_MENTAL
  OUTRO
}

enum StatusPreCadastro {
  NOVO
  EM_CONTATO
  CONVERTIDO
  DESCARTADO
}

/// Pedido de contato enviado pelo formulário do site (antes de virar paciente).
model PreCadastro {
  id               String            @id @default(cuid())
  nome             String
  telefone         String
  email            String?
  modalidade       Modalidade?
  area             AreaAtendimento?
  melhorHorario    String?
  /// O que a pessoa escreveu sobre o motivo da procura (criptografado).
  motivoCripto     String?
  consentimentoEm  DateTime
  status           StatusPreCadastro @default(NOVO)
  observacaoCripto String?
  pacienteId       String?           @unique
  paciente         Paciente?         @relation(fields: [pacienteId], references: [id])
  fichas           FichaAnamnese[]
  ip               String?
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt

  @@index([status, criadoEm])
}

enum StatusPaciente {
  ATIVO
  PAUSADO
  ALTA
  INATIVO
}

model Paciente {
  id                   String           @id @default(cuid())
  nome                 String
  nomeSocial           String?
  dataNascimento       DateTime?
  cpf                  String?
  telefone             String?
  email                String?
  /// Endereço (necessário para atendimento em domicílio).
  endereco             String?
  cidade               String?
  profissao            String?
  estadoCivil          String?
  contatoEmergencia    String?
  telefoneEmergencia   String?
  /// Responsável legal (paciente menor de idade).
  responsavelNome      String?
  responsavelCpf       String?
  responsavelTelefone  String?
  modalidade           Modalidade?
  area                 AreaAtendimento?
  /// Gestação: data provável do parto. Puerpério: data do nascimento do bebê.
  dataReferenciaBebe   DateTime?
  comoConheceu         String?
  /// Valor combinado por sessão (centavos) — usado no financeiro.
  valorSessaoCentavos  Int?
  status               StatusPaciente   @default(ATIVO)
  inicioAtendimento    DateTime?
  /// Queixa inicial / demanda (criptografado).
  queixaCripto         String?
  /// Observações gerais (criptografado).
  observacoesCripto    String?
  consentimentoLgpdEm  DateTime?
  preCadastro          PreCadastro?
  atendimentos         Atendimento[]
  registros            RegistroProntuario[]
  pagamentos           Pagamento[]
  fichas               FichaAnamnese[]
  criadoEm             DateTime         @default(now())
  atualizadoEm         DateTime         @updatedAt

  @@index([status, nome])
}

// ----------------------------------------------------------------------------
// AGENDA E PRONTUÁRIO
// ----------------------------------------------------------------------------

enum StatusAtendimento {
  AGENDADO
  REALIZADO
  FALTOU
  DESMARCADO_PACIENTE
  DESMARCADO_PSICOLOGA
}

/// Uma sessão na agenda. "inicio" é o instante exato (UTC); a tela mostra e
/// lê no horário de Brasília.
model Atendimento {
  id                  String              @id @default(cuid())
  pacienteId          String
  paciente            Paciente            @relation(fields: [pacienteId], references: [id])
  inicio              DateTime
  duracaoMin          Int                 @default(50)
  modalidade          Modalidade
  status              StatusAtendimento   @default(AGENDADO)
  /// Link da videochamada (atendimento online).
  linkOnline          String?
  /// Recado de agenda, NÃO clínico (ex.: "vem com o bebê").
  recado              String?
  /// Valor da sessão no momento do agendamento (centavos) — base do financeiro.
  valorCentavos       Int?
  /// Falta só entra na conta do paciente se a psicóloga marcar para cobrar.
  cobrarFalta         Boolean             @default(false)
  /// Agendamentos criados juntos pelo "repetir toda semana".
  serieId             String?
  registros           RegistroProntuario[]
  envios              EnvioMensagem[]
  criadoEm            DateTime            @default(now())
  atualizadoEm        DateTime            @updatedAt

  @@index([inicio])
  @@index([pacienteId, inicio])
}

enum TipoRegistro {
  EVOLUCAO
  ANOTACAO
  RETIFICACAO
}

/// Registro do prontuário (Resolução CFP 001/2009). NUNCA é alterado nem
/// apagado: uma correção é um novo registro RETIFICACAO apontando o original.
model RegistroProntuario {
  id            String              @id @default(cuid())
  pacienteId    String
  paciente      Paciente            @relation(fields: [pacienteId], references: [id])
  atendimentoId String?
  atendimento   Atendimento?        @relation(fields: [atendimentoId], references: [id])
  tipo          TipoRegistro
  /// Texto do registro (criptografado).
  textoCripto   String
  retificaId    String?
  retifica      RegistroProntuario? @relation("Retificacoes", fields: [retificaId], references: [id])
  retificacoes  RegistroProntuario[] @relation("Retificacoes")
  autorId       String?
  /// Congelado: continua certo mesmo se o usuário mudar de nome.
  autorNome     String
  criadoEm      DateTime            @default(now())

  @@index([pacienteId, criadoEm])
  @@index([atendimentoId])
}

// ----------------------------------------------------------------------------
// FINANCEIRO
// ----------------------------------------------------------------------------
// O que o paciente deve NÃO é gravado: sai das sessões (realizadas, e faltas
// marcadas para cobrar) pelo valor de cada uma. Aqui ficam só os pagamentos.

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  TRANSFERENCIA
  OUTRO
}

/// Pagamento recebido de um paciente. Nunca é apagado: erro = estorno.
model Pagamento {
  id             String         @id @default(cuid())
  pacienteId     String
  paciente       Paciente       @relation(fields: [pacienteId], references: [id])
  /// Dia do recebimento (meia-noite UTC).
  data           DateTime
  valorCentavos  Int
  forma          FormaPagamento
  /// Quem pagou, quando não é o próprio paciente (carnê-leão pede o CPF).
  pagadorNome    String?
  pagadorCpf     String?
  /// Controle: recibo já emitido no app Receita Saúde.
  reciboEmitido  Boolean        @default(false)
  observacao     String?
  estornadoEm    DateTime?
  estornoMotivo  String?
  autorNome      String
  criadoEm       DateTime       @default(now())

  @@index([pacienteId, data])
  @@index([data])
}

enum CategoriaDespesa {
  SALA
  CONSELHO
  SUPERVISAO
  FORMACAO
  MATERIAL
  DIVULGACAO
  IMPOSTOS
  TRANSPORTE
  SISTEMAS
  OUTROS
}

/// Conta a pagar do consultório.
model Despesa {
  id             String           @id @default(cuid())
  descricao      String
  categoria      CategoriaDespesa
  valorCentavos  Int
  /// Dia do vencimento (meia-noite UTC).
  vencimento     DateTime
  /// Dia em que foi paga (meia-noite UTC); vazio = em aberto.
  pagoEm         DateTime?
  forma          FormaPagamento?
  observacao     String?
  /// Despesas criadas juntas pelo "repetir todo mês".
  serieId        String?
  criadoEm       DateTime         @default(now())
  atualizadoEm   DateTime         @updatedAt

  @@index([vencimento])
  @@index([pagoEm])
}

// ----------------------------------------------------------------------------
// FICHA DE ANAMNESE (enviada por link)
// ----------------------------------------------------------------------------

enum StatusFicha {
  PENDENTE
  RESPONDIDA
  CANCELADA
}

/// Ficha de anamnese enviada por link (WhatsApp) a um interessado ou paciente.
/// O link carrega o "token": aleatório (32 bytes), de uso único e com prazo.
/// Quem tem o link só consegue PREENCHER a ficha, nunca ler nada. Depois de
/// respondida, as respostas nunca mudam (fazem parte do prontuário).
model FichaAnamnese {
  id               String       @id @default(cuid())
  token            String       @unique
  /// Versão do modelo de perguntas usada (src/lib/anamnese/modelo.ts).
  modeloVersao     Int
  status           StatusFicha  @default(PENDENTE)
  preCadastroId    String?
  preCadastro      PreCadastro? @relation(fields: [preCadastroId], references: [id])
  pacienteId       String?
  paciente         Paciente?    @relation(fields: [pacienteId], references: [id])
  /// Nome de quem vai receber (para a saudação e a lista).
  nomeDestinatario String
  expiraEm         DateTime
  /// Respostas (JSON criptografado).
  respostasCripto  String?
  respondidaEm     DateTime?
  consentimentoEm  DateTime?
  ip               String?
  enviadaPorNome   String
  criadoEm         DateTime     @default(now())

  @@index([status, criadoEm])
  @@index([pacienteId])
  @@index([preCadastroId])
}

// ----------------------------------------------------------------------------
// MENSAGENS AO PACIENTE (confirmação e lembretes, enviados com um toque)
// ----------------------------------------------------------------------------

enum TipoMensagem {
  AGENDAMENTO
  LEMBRETE
}

/// Texto da mensagem de confirmação e de cada lembrete. A psicóloga edita,
/// cria e desliga. Variáveis: {nome} {data} {hora} {onde} {serie}.
model ModeloMensagem {
  id              String          @id @default(cuid())
  tipo            TipoMensagem
  nome            String
  /// Lembrete: quantos minutos antes da sessão (1440 = 1 dia, 60 = 1 hora).
  antecedenciaMin Int?
  texto           String
  ativo           Boolean         @default(true)
  envios          EnvioMensagem[]
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
}

/// Registro de que uma mensagem foi enviada (ou pulada) para uma sessão.
model EnvioMensagem {
  id             String          @id @default(cuid())
  atendimentoId  String
  atendimento    Atendimento     @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  modeloId       String?
  modelo         ModeloMensagem? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  pulado         Boolean         @default(false)
  enviadoPorNome String
  enviadoEm      DateTime        @default(now())

  @@unique([atendimentoId, modeloId])
  @@index([enviadoEm])
}
