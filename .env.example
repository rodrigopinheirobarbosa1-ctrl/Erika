# ---------------------------------------------------------------------------
# Configuração do site/sistema da Érika
#
# Este é o MODELO. Na Vercel estas variáveis ficam no painel do projeto
# (Settings > Environment Variables). As do banco a Vercel cria sozinha.
# ---------------------------------------------------------------------------

# Endereço do banco PostgreSQL (Neon, criado na aba Storage da Vercel).
DATABASE_URL="postgresql://erika:erika@localhost:5432/erika"

# Mesmo banco, sem "pooler". Usado só para criar/atualizar as tabelas.
DATABASE_URL_UNPOOLED="postgresql://erika:erika@localhost:5432/erika"

# Chave que embaralha (criptografa) as anotações sensíveis dos pacientes no
# banco. Pode ser qualquer frase/sequência com 32 caracteres ou mais (quanto
# mais aleatória, melhor). NUNCA publique e NUNCA troque depois de ter dados:
# sem a chave original, as anotações não podem mais ser lidas. Guarde uma
# cópia num lugar seguro (ex.: gerenciador de senhas).
CHAVE_CRIPTOGRAFIA="troque-por-uma-frase-longa-e-aleatoria-so-sua"
